{
  "template_name": "neta-scientific",
  "source_sample": "US - Neta Scientific Current/Future Price.xlsx",
  "description": "US Neta Scientific catalog (xlsx, 62 columns). Current ListPrice/NetaCost are repeated under the legacy '2021' headers with the same values; all 2dp text USD for the price period. Status and hazard flag come from cst_status_ghs_label.csv, CAS from raw CAS lookups.",
  "file_type": "xlsx",
  "sku_column": "SupplierPartNumber",
  "price_columns": [
    "Current ListPrice",
    "Current NetaCost",
    "2021 ListPrice",
    "2021 NetaCost"
  ],
  "columns": [
    {"header": "SupplierName", "source": "master", "expression": "row['manufacturer'].rstrip('.')"},
    {"header": "SupplierPartNumber", "source": "master", "expression": "row['sku']"},
    {"header": "NetaPartNumber", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ReplacementPartNumber", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "UM", "source": "constant", "expression": "'each'"},
    {"header": "Qty", "source": "constant", "expression": "'1 each'"},
    {"header": "Product Size", "source": "master", "expression": "row['size'] + ' ' + row['size_unit']"},
    {"header": "GroupName", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "MainLevel", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Level2Category", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "NetaProductCategory", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Manufacturer", "source": "master", "expression": "row['manufacturer'].rstrip('.')"},
    {"header": "Product Name", "source": "master", "expression": "cst_product_name(row, raw=True)"},
    {"header": "ShortDescription (256 Characters)", "source": "master", "expression": "cst_product_name(row, raw=True)"},
    {"header": "LongDescription (Text, HTML, or Unicode-8 Coding is Acceptable with no Character Limit)", "source": "master", "expression": "cst_product_name(row, raw=True) + ' ' + row['size'] + row['size_unit'].replace(chr(181), 'u')"},
    {"header": "UNSPSC", "source": "master", "expression": "row['unspsc']"},
    {"header": "Current ListPrice", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, 0)"},
    {"header": "Current NetaCost", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, discount)"},
    {"header": "DropShip", "source": "constant", "expression": "'Y'"},
    {"header": "Lead Time", "source": "constant", "expression": "'1'"},
    {"header": "Hazardous", "source": "constant", "expression": "'N'"},
    {"header": "Shipping Charge", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "SpecialHandlingFee", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "CountryOfOrigin", "source": "constant", "expression": "'US'"},
    {"header": "2021 ListPrice", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, 0)"},
    {"header": "2021 NetaCost", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, discount)"},
    {"header": "Status", "source": "constant", "expression": "lookup(row['sku'], 'cst_status_ghs_label.csv', 'product_status', 'Released')"},
    {"header": "EffectiveDate", "source": "customer", "expression": "date_mmddyy(customer['price_valid_from'])"},
    {"header": "ExpireDate", "source": "customer", "expression": "date_mmddyy(customer['price_valid_until'])"},
    {"header": "MinOrderQty", "source": "constant", "expression": "'1'"},
    {"header": "MaxOrderQty", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "HighResImageURL", "source": "master", "expression": "row['image_url']"},
    {"header": "LowResImageURL", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "HighResImageName", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "LowResImageName", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Made to order", "source": "constant", "expression": "'N'"},
    {"header": "CAS Number", "source": "master", "expression": "lookup(row['sku'], 'cst_constituent_cas_raw.csv', 'constituent_cas_number_raw', '').replace(';', ', ') or lookup(row['sku'], 'cst_commercial_cas_raw.csv', 'commercial_cas_number_raw', '')"},
    {"header": "Purity", "source": "master", "expression": "lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'purity')"},
    {"header": "Product Chemical Name", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Chemical Structure", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Refrigerated-Frozen", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Temperature", "source": "master", "expression": "row['storage_temperature']"},
    {"header": "Width", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Depth", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Height", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Weight", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Shipping Method", "source": "constant", "expression": "'Overnight'"},
    {"header": "MSDS URL", "source": "master", "expression": "msds_url_or_blank(row)"},
    {"header": "More Information URL", "source": "master", "expression": "row['product_url']"},
    {"header": "VideoURL", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "VideoFileName", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Keywords", "source": "master", "expression": "lookup(row['sku'], 'cst_product_keywords.csv', 'product_keywords')"},
    {"header": "CompetitorPartNumber", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "CompetitorName", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ProductLine", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "attribute_set", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Visibility", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Tax Class", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Send_To_GP", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "GP_VendorID", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "store_id", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Is Hazardous Material?", "source": "constant", "expression": "lookup(row['sku'], 'cst_status_ghs_label.csv', 'ghs_label', 'N')"}
  ]
}
