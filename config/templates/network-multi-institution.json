{
  "template_name": "network-multi-institution",
  "source_sample": "US - Sciquest Current/Future Price Excel.xlsx",
  "description": "US SciQuest/Jaggaer network file (xlsx, 21 columns): one row per SKU, one price column per member institution (about 20), each using customer.institutions.<key>.discount_percentage on the USD list for the price period.",
