{
  "template_name": "de-ghx-europe-catalog",
  "source_sample": "DE - GHX Europe Catalog (1).xlsx",
  "description": "DE GHX Europe catalog (xlsx, 181 columns, most always blank) at 0%: ListPrice is EUR list as 2dp text, PurchasePrice blank. SearchKeywords comes from a copied real-file snapshot (ghx_europe_search_keywords_snapshot.csv) with a target-alternate-names fallback. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "ItemCode",
  "price_columns": [
    "ListPrice"
  ],
  "columns": [
    {
      "header": "ItemCode",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "Description",
      "source": "master",
      "expression": "row['long_description'][:100]"
    },
    {
      "header": "LongDescription",
      "source": "master",
      "expression": "row['long_description'] + ((' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev', '') + ')') if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev', '') else '')"
    },
    {
      "header": "UOMCode",
      "source": "master",
      "expression": "row['uom'].upper()"
    },
    {
      "header": "UOMDescription",
      "source": "constant",
      "expression": "''",
      "allow_blank_description": true
    },
    {
      "header": "QOM",
