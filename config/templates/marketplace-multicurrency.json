{
  "template_name": "marketplace-multicurrency",
  "source_sample": "US - Zageno Current Price-2026-06-13_08.07.01.xlsx",
  "description": "US Zageno (Current) marketplace file (xlsx, 36 columns). USD list for the period; GBP and EUR columns are raw price strings (cst_uk_clp.csv, eu_list_price); 'UCB Celltech Price' is GBP list as 2dp text. Shipping blocks per region are constants.",
  "file_type": "xlsx",
  "sku_column": "Manufacturer Catalog ID",
  "price_columns": ["List Price US [USD]", "List Price GB [GBP]", "List Price EU [EUR]", "UCB Celltech Price"],
  "columns": [
    {"header": "Product Category", "source": "master", "expression": "row['product_classification']"},
    {"header": "Product Name", "source": "master", "expression": "ariba_name(row) + ' ' + sku_leading_digits(row['sku'])"},
    {"header": "Product Description", "source": "master", "expression": "cst_name_with_suffix(row, 'size', raw=True)"},
    {"header": "Package Content", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Brand Name", "source": "master", "expression": "row['manufacturer'].rstrip('.')"},
    {"header": "Manufacturer Catalog ID", "source": "master", "expression": "row['sku']"},
    {"header": "Supplier Catalog ID", "source": "master", "expression": "row['sku']"},
    {"header": "Packaging Quantity", "source": "master", "expression": "'1'"},
    {"header": "Product Size/Quantity", "source": "master", "expression": "row['size']"},
    {"header": "Unit", "source": "master", "expression": "row['size_unit']"},
    {"header": "List Price US [USD]", "source": "master", "expression": "price_text(row['list_price_usd'])"},
    {"header": "List Price GB [GBP]", "source": "override", "expression": "lookup(row['sku'], 'cst_uk_clp.csv', 'uk_clp_future' if customer.get('price_period') == 'future' else 'uk_clp') or (price_text(customer['overrides']['regional_prices'][row['sku']]['gbp']) if 'gbp' in customer.get('overrides', {}).get('regional_prices', {}).get(row['sku'], {}) else '')"},
    {"header": "List Price EU [EUR]", "source": "override", "expression": "lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'eu_list_price') or price_text(row['list_price_eur'])"},
    {"header": "UCB Celltech Price", "source": "override", "expression": "price_text(row['list_price_gbp'])"},
    {"header": "Zageno Discount [%]", "source": "customer", "expression": "discount if discount else ''"},
    {"header": "Price Valid From", "source": "customer", "expression": "customer['price_valid_from']"},
    {"header": "Price Valid Until", "source": "customer", "expression": "customer['price_valid_until']"},
    {"header": "Minimum Order Quantity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Shipping Country [US]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Default Carrier [US]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Order Processing Time [US]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Est. Transit Time [US]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Shipping Country [GB]", "source": "constant", "expression": "'The Netherlands'"},
    {"header": "Default Carrier [GB]", "source": "constant", "expression": "'DHL'"},
    {"header": "Order Processing Time [GB]", "source": "constant", "expression": "'2'"},
    {"header": "Est. Transit Time [GB]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Shipping Country [EU]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Default Carrier [EU]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Order Processing Time [EU]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Est. Transit Time [EU]", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Shipping Details", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier Information", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier Product URL", "source": "master", "expression": "row['product_url']"},
    {"header": "Resource URL", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Image URL", "source": "master", "expression": "row['image_url']"},
    {"header": "Product Specifications", "source": "constant", "expression": "''", "allow_blank_description": true}
  ]
}
