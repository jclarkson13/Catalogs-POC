      "source": "constant",
      "expression": "''"
    },
    {
      "header": "NORM",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "SPECIALTREATMENTCLASS",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ARTICLEREFTYP",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ARTICLEREFQTY",
      "source": "constant",
