{
  "template_name": "fskk-staffelpreis",
  "source_sample": "DE - FSKK Current/Future Price.xlsx",
  "description": "DE FSKK tiered price list (xlsx, 26 German columns). Only the first volume tier (Staffel_1/Rabatt_1/Ihr_Nettopreis_1) is filled; net price is EUR discounted, rounded half-up as text. Kurztext/Langtext come from clean_coupa_description and Google Merchant fields. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv. Prices apply the config discount; Rabatt_1 prints overrides.label_discount_percentage when set (the Future file's stale 17.5% label).",
  "file_type": "xlsx",
  "sku_column": "Artikelnr",
  "price_columns": ["Listenpreis", "Ihr_Nettopreis_1"],
  "columns": [
    {"header": "Lieferant", "source": "constant", "expression": "'Cell Signaling Technology Europe'"},
    {"header": "Stand", "source": "customer", "expression": "customer['price_valid_from'][8:10] + '.' + customer['price_valid_from'][5:7] + '.' + customer['price_valid_from'][:4]"},
    {"header": "gültig_bis", "source": "customer", "expression": "customer['price_valid_until'][8:10] + '.' + customer['price_valid_until'][5:7] + '.' + customer['price_valid_until'][:4]"},
    {"header": "Artikelnr", "source": "master", "expression": "row['sku']"},
    {"header": "Kurztext", "source": "master", "expression": "clean_coupa_description(row['long_description'], 'us')[:35]"},
    {"header": "Langtext", "source": "master", "expression": "clean_coupa_description(row['long_description'], 'us') + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '') + ' (' + row['size'] + ' ' + row['size_unit'] + ')'"},
    {"header": "Mengeneinheit", "source": "master", "expression": "row['size'] + ' ' + row['size_unit'] + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '')"},
    {"header": "Kategorie", "source": "master", "expression": "lookup(row['sku'], 'cst_google_merchant_fields.csv', 'species_reactivity')"},
    {"header": "Listenpreis", "source": "master", "expression": "str(int(round(price_for(row, 'list_price_eur', customer), 0)))"},
    {"header": "Staffel_Sonderpreis", "source": "constant", "expression": "'0'"},
    {"header": "Sonderpreis", "source": "constant", "expression": "'0'"},
    {"header": "Staffel_1", "source": "constant", "expression": "'1'"},
    {"header": "Rabatt_1", "source": "master", "expression": "str(round(customer.get('overrides', {}).get('label_discount_percentage', discount)/100, 3))"},
    {"header": "Ihr_Nettopreis_1", "source": "master", "expression": "price_for_rounded_half_up(row, 'list_price_eur', customer, discount)"},
    {"header": "Staffel_2", "source": "constant", "expression": "'0'"},
    {"header": "Rabatt_2", "source": "constant", "expression": "'0'"},
    {"header": "Ihr_Nettopreis_2", "source": "constant", "expression": "'0'"},
    {"header": "Staffel_3", "source": "constant", "expression": "'0'"},
    {"header": "Rabatt_3", "source": "constant", "expression": "'0'"},
    {"header": "Ihr_Nettopreis_3", "source": "constant", "expression": "'0'"},
    {"header": "Währung", "source": "constant", "expression": "'EUR'"},
    {"header": "Steuersatz", "source": "constant", "expression": "'0.19'"},
    {"header": "Transporttemperatur", "source": "master", "expression": "row['shipping_conditions']"},
    {"header": "Lagertemperatur", "source": "master", "expression": "row['storage_temperature']"},
    {"header": "URL", "source": "master", "expression": "'https://www.cellsignal.de/products/' + sku_leading_digits(row['sku']) + '?country=DE'"},
    {"header": "Bemerkung", "source": "constant", "expression": "''"}
  ]
}
