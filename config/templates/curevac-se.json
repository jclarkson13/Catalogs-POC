{
  "template_name": "curevac-se",
  "source_sample": "DE - Curevac SE Current/Future Price Export.xlsx",
  "description": "DE Curevac SE punchout catalog (xlsx, 29 CIF-style columns, plain 'Supplier ID' header, TradeCentric Supplier URL). Unit Price (discounted) and Market Price are 2dp text EUR for the price period. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "Supplier Part ID",
  "price_columns": [
    "Unit Price",
    "Market Price"
  ],
  "columns": [
    {"header": "Supplier ID", "source": "constant", "expression": "'AN01522798508'"},
    {"header": "Supplier Part ID", "source": "master", "expression": "row['sku']"},
    {"header": "Manufacturer Part ID", "source": "constant", "expression": "''"},
    {"header": "Item Description", "source": "master", "expression": "cst_name_with_suffix(row, 'blank_none', 'keep')"},
    {"header": "SPSC Code", "source": "master", "expression": "row['unspsc']"},
    {"header": "Unit Price", "source": "master", "expression": "price_for_rounded(row, 'list_price_eur', customer, discount)"},
    {"header": "Unit of Measure", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "Lead Time", "source": "constant", "expression": "'3'"},
    {"header": "Manufacturer Name", "source": "master", "expression": "row['manufacturer']"},
    {"header": "Supplier URL", "source": "constant", "expression": "'https://connect.tradecentric.com/gateway/punchout/request/catalog/Vi651ae949a7717'"},
    {"header": "Manufacturer URL", "source": "master", "expression": "(raw_price_eur(row, customer)) if customer.get('price_period') == 'future' else (row['product_url'].replace('cellsignal.com', 'cellsignal.de').replace('.html', '') + '?country=DE')"},
    {"header": "Market Price", "source": "master", "expression": "raw_price_eur(row, customer)"},
    {"header": "Short Name", "source": "master", "expression": "cst_name_with_suffix(row, 'blank_none', 'keep')[:50]"},
    {"header": "AuxiliaryImages", "source": "master", "expression": "row['image_url']"},
    {"header": "PriceConfiguration", "source": "constant", "expression": "''"},
    {"header": "RelatedItems", "source": "constant", "expression": "''"},
    {"header": "QuantityInterval", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "MinimumQuantity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Attachments", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier Part Auxiliary ID", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Language", "source": "constant", "expression": "'en_US'"},
    {"header": "Currency", "source": "constant", "expression": "'EUR'"},
    {"header": "Effective Date", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Expiration Date", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Territory Available", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "PunchOut Enabled", "source": "constant", "expression": "'True'"},
    {"header": "PunchoutLevel", "source": "constant", "expression": "'product'"},
    {"header": "Image", "source": "master", "expression": "row['image_url'] or 'https://media.cellsignal.com/product/image/no_image_available_placeholder.jpeg'"},
    {"header": "Thumbnail", "source": "master", "expression": "row['image_url'] or 'https://media.cellsignal.com/product/image/no_image_available_placeholder.jpeg'"}
  ]
}
