{
  "template_name": "de-boehringer-austria",
  "source_sample": "DE - Boehringer Forschungsinstitut Austria + DE - Boehringer RCV Austria (Current/Future Price) - identical 34-column layout and identical 24,765-row population across all 4 real files (verified header-for-header and SKU-for-SKU, not assumed from one sample), different discount per institution",
  "description": "DE/AT Boehringer Ingelheim Austria punchout catalog (xlsx, 34 columns, first header 'FIELDNAMES: Supplier ID'), shared by two entities and both periods. EUR prices rounded half-up as text; descriptions use clean_boehringer_description (replicates the real '00AE' for the registered sign). Includes bi_* and intrastat columns. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv. Unit Price applies the config discount in both periods (the Future configs are 0%, matching the real files).",
  "file_type": "xlsx",
  "sku_column": "Supplier Part ID",
  "price_columns": ["Unit Price", "Market Price"],
  "columns": [
    {"header": "FIELDNAMES: Supplier ID", "source": "constant", "expression": "'AN01522798508'"},
    {"header": "Supplier Part ID", "source": "master", "expression": "row['sku']"},
    {"header": "Manufacturer Part ID", "source": "master", "expression": "row['sku']"},
    {"header": "Item Description", "source": "master", "expression": "clean_boehringer_description(row['long_description']) + (' (' + lookup(row['sku'], 'cst_test_count.csv', 'test_count', '') + ')' if lookup(row['sku'], 'cst_test_count.csv', 'test_count', '') else '')"},
    {"header": "SPSC Code", "source": "constant", "expression": "'32169090'"},
    {"header": "Unit Price", "source": "master", "expression": "price_for_rounded_half_up(row, 'list_price_eur', customer, discount)"},
    {"header": "Unit of Measure", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "Lead Time", "source": "constant", "expression": "'3'"},
    {"header": "Manufacturer Name", "source": "master", "expression": "row['manufacturer']"},
    {"header": "Supplier URL", "source": "master", "expression": "row['product_url'].replace('www.cellsignal.com', 'www.cellsignal.de').replace('.html', '')"},
    {"header": "Manufacturer URL", "source": "master", "expression": "row['product_url'].replace('www.cellsignal.com', 'www.cellsignal.de').replace('.html', '')"},
    {"header": "Market Price", "source": "master", "expression": "price_for_rounded_half_up(row, 'list_price_eur', customer, 0)"},
    {"header": "Short Name", "source": "master", "expression": "clean_boehringer_description(row['long_description'])[:50]"},
    {"header": "AuxiliaryImages", "source": "constant", "expression": "''"},
    {"header": "PriceConfiguration", "source": "constant", "expression": "''"},
    {"header": "RelatedItems", "source": "constant", "expression": "''"},
    {"header": "QuantityInterval", "source": "constant", "expression": "'1'"},
    {"header": "MinimumQuantity", "source": "constant", "expression": "'1'"},
    {"header": "Attachments", "source": "constant", "expression": "''"},
    {"header": "Supplier Part Auxiliary ID", "source": "constant", "expression": "''"},
    {"header": "Language", "source": "constant", "expression": "'en_US'"},
    {"header": "Currency", "source": "constant", "expression": "'EUR'"},
    {"header": "Effective Date", "source": "constant", "expression": "''"},
    {"header": "Expiration Date", "source": "constant", "expression": "''"},
    {"header": "Territory Available", "source": "constant", "expression": "''"},
    {"header": "bi_plant", "source": "constant", "expression": "''"},
    {"header": "bi_service_flag", "source": "constant", "expression": "''"},
    {"header": "bi_item_matnr", "source": "constant", "expression": "''"},
    {"header": "instrastat_weight_unit", "source": "constant", "expression": "'KG'"},
    {"header": "instrastat_netweight", "source": "constant", "expression": "''"},
    {"header": "instrastat_comcode", "source": "master", "expression": "lookup(row['sku'], 'benelux_vwr_commodity_codes.csv', 'commodity_code', '')"},
    {"header": "instrastat_country_of_origin", "source": "constant", "expression": "'US'"},
    {"header": "Image", "source": "master", "expression": "row['image_url']"},
    {"header": "Thumbnail", "source": "master", "expression": "row['image_url']"}
  ]
}
