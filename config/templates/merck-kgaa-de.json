{
  "template_name": "merck-kgaa-de",
  "source_sample": "DE - Merck KGaA Current/Future Price.xlsx",
  "description": "DE Merck KGaA punchout catalog (xlsx, sheet Sheet1, 77 CIF-style columns with repeated Source/Description headers). EUR prices rounded half-up as text for the price period; the UNSPSC-domain 'Value' is a constant; descriptions use clean_merck_description. Customers exclude merck_kgaa_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "Supplier Part ID",
  "price_columns": [
    "Unit Price",
    "Market Price",
    "Amount"
  ],
  "sheet_name": "Sheet1",
  "columns": [
    {
      "header": "Supplier ID",
      "source": "constant",
      "expression": "'AN01522798508'"
    },
    {
      "header": "Supplier Part ID",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "Item Description",
      "source": "master",
      "expression": "f\"{clean_merck_description(row['long_description'])} {row['size']} {row['size_unit'].replace(chr(181), 'u')}\""
    },
    {
      "header": "Unit Price",
      "source": "master",
      "expression": "price_for_rounded_half_up(row, 'list_price_eur', customer, discount)"
    },
    {
      "header": "Unit of Measure",
      "source": "master",
      "expression": "row['uom'].upper()"
    },
    {
      "header": "Short Name",
      "source": "master",
      "expression": "f\"{clean_merck_description(row['long_description'])} {row['size']} {row['size_unit'].replace(chr(181), 'u')}\""
    },
    {
      "header": "Domain",
      "source": "constant",
      "expression": "'UNSPSC'"
    },
    {
      "header": "Value",
      "source": "constant",
      "expression": "'3430100'"
    },
    {
      "header": "Thumbnail",
      "source": "master",
      "expression": "row['image_url']"
    },
    {
      "header": "Normal",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Detailed",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Manufacturer Part ID",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "Manufacturer Name",
      "source": "master",
      "expression": "row['manufacturer'].replace(', Inc.', '')"
    },
    {
      "header": "Supplier URL",
      "source": "master",
      "expression": "((lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'eu_future_list_price' if customer.get('price_period') == 'future' else 'eu_list_price', '') or price_for_rounded_half_up(row, 'list_price_eur', customer, 0)) if discount == 0 else price_for_rounded_half_up(row, 'list_price_eur', customer, discount)) if customer.get('price_period') == 'future' else f\"https://www.cellsignal.de/products/{leading_digits(row['sku'])}?country=DE\""
    },
    {
      "header": "Manufacturer URL",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Lead Time",
      "source": "constant",
      "expression": "''"
    },
