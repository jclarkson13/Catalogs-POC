{
  "template_name": "amici-catalog",
  "source_sample": "UK - Amici Catalog Current/Future Price.xlsx",
  "description": "UK Amici Solutions marketplace catalog (xlsx, 47 columns) in GBP: listPrice plus discounted 'Amici price' as 2dp text. Hazard, CAS, shelf-life, SDS and category columns come from master lookups; most chemical-property columns are blank. Customers exclude the SKUs in coupa_marketplace_excluded_uk.csv.",
  "file_type": "xlsx",
  "sku_column": "supplierPartNo",
  "price_columns": [
    "listPrice",
    "Amici price"
  ],
  "columns": [
    {"header": "supplierPartNo", "source": "master", "expression": "row['sku']"},
    {"header": "Product Description", "source": "master", "expression": "cst_product_name(row, raw=True).replace('®', '00AE')"},
    {"header": "noOfUnits", "source": "constant", "expression": "'1'"},
    {"header": "unitSize", "source": "master", "expression": "row['size']"},
    {"header": "unit", "source": "master", "expression": "row['size_unit'].replace('µ', 'u')"},
    {"header": "listPrice", "source": "master", "expression": "raw_price_gbp(row, customer)"},
    {"header": "Amici price", "source": "master", "expression": "price_for_rounded(row, 'list_price_gbp', customer, discount)"},
    {"header": "currency", "source": "constant", "expression": "'GBP'"},
    {"header": "Price expiryDate", "source": "customer", "expression": "customer['price_valid_until'][5:7] + '/' + customer['price_valid_until'][8:10] + '/' + customer['price_valid_until'][:4]"},
    {"header": "QuoteNumber", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Cat1", "source": "constant", "expression": "'Biologicals'"},
    {"header": "Cat2", "source": "master", "expression": "lookup(row['sku'], 'cst_sciquest_category.csv', 'sciquest_category_dflt', 'Primary Antibodies')"},
    {"header": "Cat3", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Cat4", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Cat5", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "SupplierProductURL", "source": "master", "expression": "row['product_url']"},
    {"header": "Synonyms", "source": "master", "expression": "lookup(row['sku'], 'cst_target_alternate_names.csv', 'target_alternate_names')"},
    {"header": "Brand", "source": "master", "expression": "row['manufacturer']"},
    {"header": "ManufacturePartNo", "source": "master", "expression": "row['sku']"},
    {"header": "leadTime", "source": "constant", "expression": "'3'"},
    {"header": "Carriage Fee", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "INCOTerms", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "purity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "CASNumber", "source": "master", "expression": "','.join(v for v in [lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'commercial_cas_number', ''), lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'constituent_cas_number', '')] if v)"},
    {"header": "MDLNumber", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ChemicalFormula", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "MolecularWeight", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Potency", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ECNumber", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Shelflife", "source": "master", "expression": "lookup(row['sku'], 'cst_shelf_life.csv', 'shelf_life')"},
    {"header": "URL to SDS", "source": "master", "expression": "'' if row['msds_url'].endswith('resources-safety-data-sheets') else lookup(row['sku'], 'cst_sds_url_de.csv', 'sds_url_eu_en', row['msds_url'])"},
    {"header": "SupplierImageURLSmall", "source": "master", "expression": "row['image_url']"},
    {"header": "SupplierImageURLBig", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "AmiciUserGuide", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "WarrantyInfo", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "UNSPSC", "source": "master", "expression": "row['unspsc']"},
    {"header": "Sterile", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "PharmacopoeiaTested", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "GMPGrade", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "SMILES", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "OtherTechInfo", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ShippingConditions", "source": "master", "expression": "row['shipping_conditions']"},
    {"header": "StorageTemperature", "source": "master", "expression": "row['storage_temperature']"},
    {"header": "TaxRate", "source": "constant", "expression": "'Exempt'"},
    {"header": "Hazards", "source": "master", "expression": "lookup(row['sku'], 'cst_hazardous_statements.csv', 'hazardous_statements')"},
    {"header": "hazard Statements", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Restrictions", "source": "master", "expression": "''"}
  ]
}
