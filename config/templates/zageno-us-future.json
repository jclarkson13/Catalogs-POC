    },
    {
      "header": "Shipping Details",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Supplier Information",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Supplier Product URL",
      "source": "master",
      "expression": "row['product_url']"
    },
    {
      "header": "Resource URL",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Image URL",
