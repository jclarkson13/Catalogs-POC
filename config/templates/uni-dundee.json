{
  "template_name": "uni-dundee",
  "source_sample": "UK - University of Dundee Current/Future Price.xlsx",
  "description": "UK University of Dundee catalog (xlsx, 45 columns) in GBP. LIST PRICE and discounted CUSTOMER PRICE are 2dp text for the price period; DISCOUNT is written as text like '10%' from the customer discount. Customers exclude the SKUs in coupa_marketplace_excluded_uk.csv. CUSTOMER PRICE applies the config discount; DISCOUNT prints overrides.label_discount_percentage when set (the Future file's stale 10% label).",
  "file_type": "xlsx",
  "sku_column": "ITEM NUMBER/SKU",
  "price_columns": ["LIST PRICE", "CUSTOMER PRICE"],
  "columns": [
    {"header": "TRANSACTION TYPE", "source": "constant", "expression": "''"},
    {"header": "DUNS NUMBER", "source": "constant", "expression": "''"},
    {"header": "CATALOGUE KEY NAME", "source": "constant", "expression": "''"},
    {"header": "LEVEL 1 CODE", "source": "constant", "expression": "''"},
    {"header": "LEVEL 1 DESCR", "source": "constant", "expression": "''"},
    {"header": "LEVEL 2 CODE", "source": "constant", "expression": "''"},
    {"header": "LEVEL 2 DESCR", "source": "constant", "expression": "''"},
    {"header": "LEVEL 3 CODE", "source": "constant", "expression": "''"},
    {"header": "LEVEL 3 DESCR", "source": "constant", "expression": "''"},
    {"header": "LEVEL 4 CODE", "source": "constant", "expression": "''"},
    {"header": "LEVEL 4 DESCR", "source": "constant", "expression": "''"},
    {"header": "LEVEL 5 CODE", "source": "constant", "expression": "''"},
    {"header": "LEVEL 5 DESCR", "source": "constant", "expression": "''"},
    {"header": "UN/SPSC CODE", "source": "master", "expression": "row['unspsc']"},
    {"header": "MANUFACTURER", "source": "master", "expression": "row['manufacturer']"},
    {"header": "ITEM NUMBER/SKU", "source": "master", "expression": "row['sku']"},
    {"header": "ITEM DESCRIPTION", "source": "master", "expression": "row['long_description']"},
    {"header": "LIST PRICE", "source": "master", "expression": "raw_price_gbp(row, customer)"},
    {"header": "CUSTOMER PRICE", "source": "master", "expression": "price_for_rounded(row, 'list_price_gbp', customer, discount)"},
    {"header": "DISCOUNT", "source": "customer", "expression": "str(int(customer.get('overrides', {}).get('label_discount_percentage', discount))) + '%'"},
    {"header": "UNIT OF MEASURE CODE", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "MINIMUM QUANTITY", "source": "constant", "expression": "'1'"},
    {"header": "PAGE NUMBER", "source": "constant", "expression": "''"},
    {"header": "START DATE", "source": "customer", "expression": "str(int(customer['price_valid_from'][8:10])) + '/' + str(int(customer['price_valid_from'][5:7])) + '/' + customer['price_valid_from'][:4]"},
    {"header": "END DATE", "source": "customer", "expression": "str(int(customer['price_valid_until'][8:10])) + '/' + str(int(customer['price_valid_until'][5:7])) + '/' + customer['price_valid_until'][:4]"},
    {"header": "ITEM SUB", "source": "constant", "expression": "''"},
    {"header": "MANUFACTURER PART NUMBER", "source": "master", "expression": "row['sku']"},
    {"header": "IMAGE 1", "source": "master", "expression": "row['image_url']"},
    {"header": "IMAGE 2", "source": "constant", "expression": "''"},
    {"header": "TEXT 1", "source": "constant", "expression": "''"},
    {"header": "MAXIMUM QUANTITY", "source": "constant", "expression": "''"},
    {"header": "AUDIO", "source": "constant", "expression": "''"},
    {"header": "VIDEO", "source": "constant", "expression": "''"},
    {"header": "URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "ITEM USER FIELD COUNT", "source": "constant", "expression": "'0'"},
    {"header": "CONTRACT ID", "source": "constant", "expression": "''"},
    {"header": "GTIN", "source": "constant", "expression": "''"},
    {"header": "GHS HAZARD", "source": "constant", "expression": "''"},
    {"header": "UN TDG HAZARD CODE", "source": "constant", "expression": "''"},
    {"header": "CONTROL REGULATION", "source": "constant", "expression": "''"},
    {"header": "LEAD TIME", "source": "constant", "expression": "''"},
    {"header": "LONG DESCRIPTION", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "PREFERRED ITEM", "source": "constant", "expression": "''"},
    {"header": "UNIT OF MEASURE QUANTITY", "source": "master", "expression": "row['size']"},
    {"header": "UNIT OF MEASURE QUANTITY UNIT", "source": "master", "expression": "row['size_unit'].replace(chr(181), 'u')"}
  ]
}
