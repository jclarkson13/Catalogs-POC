{
  "template_name": "pmv-pharma",
  "source_sample": "US - PMV PHARMA INC Current/Future Price.xlsx",
  "description": "US PMV Pharma catalog (xlsx, 77 columns), staggered-price distributor layout plus antibody/pharmacology fields (gene, host, isotype, species). Two description columns ('Short Description' and 'ShortDescription') differ; prices are 2dp text USD for the price period.",
  "file_type": "xlsx",
  "sku_column": "SupplierPartID",
  "price_columns": [
    "Price",
    "List Price"
  ],
  "columns": [
    {"header": "ManufacturerName", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "ManufacturerPartID", "source": "master", "expression": "row['sku']"},
    {"header": "Short Description", "source": "master", "expression": "clean_pfizer_description(row['long_description'])"},
    {"header": "SupplierPartID", "source": "master", "expression": "row['sku']"},
    {"header": "ShortDescription", "source": "master", "expression": "clean_pfizer_description(row['long_description']) + ' ' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'qty_mkt_txt_abbrev_units', row['size'] + ' ' + row['size_unit'])"},
    {"header": "LongDescription", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Synonyms", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Price", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, discount)"},
    {"header": "List Price", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, 0)"},
    {"header": "Currency", "source": "constant", "expression": "'USD'"},
    {"header": "PriceBase", "source": "constant", "expression": "'1'"},
    {"header": "MinimumQuantity", "source": "constant", "expression": "'1'"},
    {"header": "QuantityInterval", "source": "constant", "expression": "'1'"},
    {"header": "StaggeredPrice", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "UOM", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "ContentUnit", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "NumberContentUnit", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Size", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "SizeUnit", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ContentUnitPrice", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "UNSPSC", "source": "master", "expression": "row['unspsc']"},
    {"header": "LeadTime", "source": "constant", "expression": "'1'"},
    {"header": "Image1", "source": "master", "expression": "row['image_url']"},
    {"header": "Image2", "source": "master", "expression": "row['image_url']"},
    {"header": "Attachment1", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Attachment2", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "\"URL\"", "source": "master", "expression": "row['product_url']"},
    {"header": "StartDate", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "EndDate", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "ArticleHint", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Remarks", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "SalesRep", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "FormName", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Antibody", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Antibody Type", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Antigen", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Applications", "source": "master", "expression": "row['assays'] or ' '"},
    {"header": "Clone", "source": "master", "expression": "{'Mono': 'Monoclonal', 'Poly': 'Polyclonal'}.get(lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'antibody_type'), lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'antibody_type'))"},
    {"header": "Concentration", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Conjugate Type", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Cross Reactivity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Discipline", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Format", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Gene", "source": "master", "expression": "lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'gene')"},
    {"header": "Host", "source": "master", "expression": "lookup(row['sku'], 'cst_google_merchant_fields.csv', 'host_species_code')"},
    {"header": "Immunogen", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Isotype", "source": "master", "expression": "lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'isotype')"},
    {"header": "Product Classification", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Secondary Antibody", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Species Nonreactivity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Species Reactivity", "source": "master", "expression": "lookup(row['sku'], 'cst_species_names.csv', 'species_names_xr')"},
    {"header": "Storage", "source": "master", "expression": "row['storage_temperature']"},
    {"header": "EMBL Accession Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Chemical Name", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "CAS Number", "source": "master", "expression": "lookup(row['sku'], 'cst_commercial_cas_raw.csv', 'commercial_cas_number_raw', '') + (', ' if lookup(row['sku'], 'cst_commercial_cas_raw.csv', 'commercial_cas_number_raw', '') and lookup(row['sku'], 'cst_constituent_cas_raw.csv', 'constituent_cas_number_raw', '') else '') + lookup(row['sku'], 'cst_constituent_cas_raw.csv', 'constituent_cas_number_raw', '').replace(';', ', ')"},
    {"header": "CAS Number Details", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Purity", "source": "master", "expression": "lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'purity')"},
    {"header": "Packaging", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Density", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Boiling Point", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Melting Point", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Molecular Formula", "source": "master", "expression": "lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'molecular_formula')"},
    {"header": "Formula", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Formula Weight", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "MSDS URL", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Assays", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "MDL Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Particle Size", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Molecular Weight Range", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "SMILES", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Category", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Preferred shipper", "source": "constant", "expression": "'FedEx'"},
    {"header": "Shipped from location", "source": "constant", "expression": "'32 Tozer Rd. Beverly, MA 01915'"},
    {"header": "Is shipping free", "source": "constant", "expression": "'No'"},
    {"header": "Usage last 12 months", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Usage calendar year", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Drop Ship", "source": "constant", "expression": "'No'"}
  ]
}
