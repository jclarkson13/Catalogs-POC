  "columns": [
    {"header": "Artikelsectie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Actie", "source": "constant", "expression": "'ADD'"},
    {"header": "Regelnummer", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Regelsoort", "source": "constant", "expression": "'Goederen'"},
    {"header": "Miniatuur", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Afbeelding", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Artikelomschrijving", "source": "master", "expression": "cst_product_name(row, raw=True)"},
    {"header": "Artikelomschrijving nieuw", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Reden wijziging omschrijving", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Winkelcategorie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Categorie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Leveranciersartikelnummer", "source": "master", "expression": "row['sku']"},
    {"header": "Leveranciersartikelnummer nieuw", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Reden wijziging artikelnummer", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Hulp-ID onderdeel leverancier", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Intern artikelnummer", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Artikelrevisie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Fabrikant", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Fabrikantartikel", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Eenheid", "source": "constant", "expression": "'STUK'"},
    {"header": "Eenheid nieuw", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Prijs (excl.BTW)", "source": "master", "expression": "price_text(row['list_price_eur'])"},
    {"header": "NETTO Prijs nieuw", "source": "master", "expression": "(lambda v: int(v) if v == int(v) else v)(round(float(row['list_price_eur']) * (1 - discount/100), 2))"},
    {"header": "Beschikbaarheid", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Doorlooptijd", "source": "master", "expression": "'2' if row['manufacturer'] == 'New England Biolabs' else '1'"},
    {"header": "UNSPSC Code", "source": "master", "expression": "row['unspsc']"},
    {"header": "Alias", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Toelichting", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Lange omschrijving", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "URL van bijlage", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "URL leverancier", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "URL fabrikant", "source": "master", "expression": "('=HYPERLINK(\"' + row['product_url'].replace('.html', '').lower() + '\", \"' + row['product_url'].replace('.html', '').lower() + '\")') if row['product_url'] else ''", "allow_blank_description": true},
    {"header": "Soort", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Informatief: Prijs (incl. BTW)", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "BTW-code", "source": "constant", "expression": "'2'"},
    {"header": "BTW-code  nieuw", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Vervaldatum", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Bestemmingsorganisatie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Bestemmingslocatie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Hoeveelheid", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Geldig vanaf", "source": "customer", "expression": "'-'.join(customer['price_valid_from'].split('-')[::-1])"},
    {"header": "Geldig t/m", "source": "customer", "expression": "'-'.join(customer['price_valid_until'].split('-')[::-1])"},
    {"header": "Staffelprijs", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Korting", "source": "constant", "expression": "''", "allow_blank_description": true}
  ]
