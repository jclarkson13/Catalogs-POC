    {"header": "Comments", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Product Noun", "source": "master", "expression": "lookup(row['sku'], 'cst_sciquest_category.csv', 'sciquest_category_dflt')"},
    {"header": "Differentiator Primary Attribute Value", "source": "master", "expression": "lookup(row['sku'], 'cst_sciquest_category.csv', 'sciquest_category_dflt')"},
    {"header": "Differentiator Secondary Attribute Value", "source": "master", "expression": "lookup(row['sku'], 'cst_sciquest_category.csv', 'sciquest_category_dflt')"},
