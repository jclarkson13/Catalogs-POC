{
  "template_name": "fisher-us",
  "source_sample": "US - Fisher Current/Future Price.xlsx",
  "description": "US Fisher Scientific catalog (xlsx, 82 columns). Cost and list are 2dp text USD for the price period; Item Description columns come from fisher_us_description() (punctuation and non-ASCII removed) and the expiry date is DD-MON-YY via format_date_ddmonyy().",
  "file_type": "xlsx",
  "sku_column": "Supplier Catalog Number",
  "price_columns": [
    "US Standard Unit Cost",
    "US Standard Unit List"
  ],
  "columns": [
    {"header": "Line Errors", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier Catalog Number", "source": "master", "expression": "row['sku']"},
    {"header": "US Fisher Catalog Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "CA Fisher Catalog number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Item Status - US", "source": "constant", "expression": "''", "allow_blank_description": true},
