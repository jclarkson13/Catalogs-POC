    {"header": "Item Description - 1000 Characters", "source": "master", "expression": "fisher_us_description(row)"},
    {"header": "Item Description - 250 Characters", "source": "master", "expression": "fisher_us_description(row)"},
    {"header": "Item Description - 30 Characters", "source": "master", "expression": "fisher_us_description(row, short=True)"},
    {"header": "Image URL", "source": "master", "expression": "row['image_url']"},
    {"header": "Manufacturer Name", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Manufacturer Catalog Number (Manufacturer item No)", "source": "master", "expression": "row['sku']"},
    {"header": "Brand", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Item Class", "source": "constant", "expression": "'Chemicals and Biochemical Reagents'"},
