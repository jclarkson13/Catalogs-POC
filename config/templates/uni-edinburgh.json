{
  "template_name": "uni-edinburgh",
  "source_sample": "UK - University of Edinburgh Current/Future Price.xlsx",
  "description": "UK University of Edinburgh Oracle-punchout-style file (xlsx, 47 columns), mostly blank optional columns. Price is discounted GBP rounded half-up as text; CAS and hazardous flags are sparse values from master lookups. Customers exclude the SKUs in coupa_marketplace_excluded_uk.csv.",
  "file_type": "xlsx",
  "sku_column": "Supplier Item",
  "price_columns": ["Price"],
  "columns": [
    {"header": "Item Section", "source": "constant", "expression": "''"},
    {"header": "Action", "source": "constant", "expression": "'SYNC'"},
    {"header": "Line Number", "source": "constant", "expression": "''"},
    {"header": "Line Type", "source": "constant", "expression": "'Goods'"},
    {"header": "Thumbnail Image", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Image", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Description", "source": "master", "expression": "' '.join(clean_gladstone_description(row['long_description']).split()) + ' ' + sku_leading_digits(row['sku']) + ' ' + row['size'] + ' ' + row['size_unit']"},
    {"header": "Category Name", "source": "constant", "expression": "''"},
    {"header": "Supplier Item", "source": "master", "expression": "row['sku']"},
    {"header": "Supplier Item Auxiliary Identifier", "source": "constant", "expression": "''"},
    {"header": "Internal Item Number", "source": "constant", "expression": "''"},
    {"header": "Expiration Date", "source": "constant", "expression": "''"},
    {"header": "Negotiated", "source": "constant", "expression": "''"},
    {"header": "Revision", "source": "constant", "expression": "''"},
    {"header": "Manufacturer", "source": "master", "expression": "row['manufacturer']"},
    {"header": "Manufacturer Part Number", "source": "master", "expression": "row['sku']"},
    {"header": "UOM", "source": "constant", "expression": "'EACH'"},
    {"header": "Price", "source": "master", "expression": "price_for_rounded_half_up(row, 'list_price_gbp', customer, discount)"},
    {"header": "Rounding Factor", "source": "constant", "expression": "''"},
    {"header": "Amount", "source": "constant", "expression": "''"},
    {"header": "Availability", "source": "constant", "expression": "''"},
    {"header": "Lead Time", "source": "constant", "expression": "'3'"},
    {"header": "UNSPSC", "source": "master", "expression": "row['unspsc']"},
    {"header": "CAS Number", "source": "lookup", "expression": "','.join(p for p in [lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'commercial_cas_number'), lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'constituent_cas_number')] if p)"},
    {"header": "Alias", "source": "constant", "expression": "''"},
    {"header": "Comments", "source": "constant", "expression": "''"},
    {"header": "Long Description", "source": "master", "expression": "clean_gladstone_description(row['long_description']) + ' ' + sku_leading_digits(row['sku'])"},
    {"header": "Attachment URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Supplier URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Manufacturer URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Ship-to Organization", "source": "constant", "expression": "''"},
    {"header": "Ship-to Location", "source": "constant", "expression": "''"},
    {"header": "Quantity", "source": "constant", "expression": "''"},
    {"header": "Start Date", "source": "constant", "expression": "''"},
    {"header": "End Date", "source": "constant", "expression": "''"},
    {"header": "Break Price", "source": "constant", "expression": "''"},
    {"header": "Item Descriptive Flexfield Context", "source": "constant", "expression": "''"},
    {"header": "Item Descriptive Flexfield Context Segment", "source": "constant", "expression": "''"},
    {"header": "Line Descriptive Flexfield Context", "source": "constant", "expression": "''"},
    {"header": "Line Descriptive Flexfield Context Segment", "source": "constant", "expression": "''"},
    {"header": "Discount", "source": "constant", "expression": "'12.5'"},
    {"header": "Parent Item", "source": "constant", "expression": "''"},
    {"header": "Supplier Parent Item", "source": "constant", "expression": "''"},
    {"header": "Top Model", "source": "constant", "expression": "''"},
    {"header": "Supplier Top Model", "source": "constant", "expression": "''"},
    {"header": "Packaging String", "source": "constant", "expression": "''"},
    {"header": "Hazardous Y/N", "source": "lookup", "expression": "'Y' if lookup(row['sku'], 'cst_hazardous_statements.csv', 'hazardous_statements') else 'N'"}
  ]
}
