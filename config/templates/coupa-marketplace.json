    },
    {
      "header": "DATASHEET",
      "source": "master",
      "expression": "lookup(row['sku'], 'cst_sds_url_de.csv', customer['sds_lookup_column'], msds_url_or_blank(row)) if customer.get('sds_lookup_column') else (msds_url_or_blank(row))"
    },
    {
      "header": "KEYWORD",
      "source": "master",
      "expression": "(lookup(row['sku'], 'cst_eclass_category_keyword.csv', 'targetname').replace('\u03b1', 'alpha').replace('\u03b5', 'epsilon').replace('\u00ae', '00AE')) if customer.get('description_region') in ('de', 'uk') else lookup(row['sku'], 'cst_eclass_category_keyword.csv', 'targetname')"
    },
