{
  "template_name": "coupa-marketplace",
  "source_sample": "DE/UK/US - Coupa Marketplace Current/Future Price.xlsx - same 59-column header layout across all three regions, differing in CURRENCY/price basis and in per-row SKU population/text-cleaning conventions - see description.",
  "description": "Coupa Marketplace BMEcat-style catalog (xlsx, 59 columns) shared by US, DE and UK customers at 0%. Price source depends on region: USD list, raw EUR (eu_list_price) or raw GBP (uk_clp) strings. DESCRIPTION_SHORT/LONG come from long_description via clean_coupa_description (UK short form has its own rule). DE/UK customers exclude their region's SKU list.",
  "file_type": "xlsx",
  "sku_column": "SUPPLIER_AID",
  "price_columns": [
    "PRICE_AMOUNT1"
  ],
  "columns": [
    {
      "header": "SUPPLIER_AID",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "DESCRIPTION_SHORT",
      "source": "master",
      "expression": "clean_coupa_description_short_uk(row['long_description']) if customer.get('description_region', 'us') == 'uk' else clean_coupa_description(row['long_description'], customer.get('description_region', 'us'))[:35]"
    },
    {
      "header": "DESCRIPTION_LONG",
      "source": "master",
      "expression": "clean_coupa_description(row['long_description'], customer.get('description_region', 'us'))"
    },
    {
      "header": "MANUFACTURER_NAME",
      "source": "master",
      "expression": "row['manufacturer'].replace(', Inc.', '')"
    },
    {
      "header": "MANUFACTURER_AID",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "COUNTRY",
      "source": "constant",
      "expression": "'US'"
    },
    {
      "header": "PRICE_QUANTITY",
      "source": "constant",
      "expression": "'1'"
    },
    {
      "header": "ORDER_UNIT",
      "source": "master",
      "expression": "row['uom'].upper()"
    },
    {
      "header": "LOWER_BOUND1",
      "source": "constant",
      "expression": "'1'"
    },
    {
      "header": "PRICE_AMOUNT1",
      "source": "master",
      "expression": "((lookup(row['sku'], 'cst_uk_clp.csv', 'uk_clp_future' if customer.get('price_period') == 'future' else 'uk_clp') if customer.get('price_currency_field') == 'gbp' else lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'eu_future_list_price' if customer.get('price_period') == 'future' else 'eu_list_price') if customer.get('price_currency_field') == 'eur' else '') if discount == 0 else '') or price_for_rounded(row, 'list_price_' + customer.get('price_currency_field', 'usd'), customer, discount)"
    },
    {
      "header": "LOWER_BOUND2",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "PRICE_AMOUNT2",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "CURRENCY",
      "source": "customer",
      "expression": "customer.get('price_currency', 'USD')"
    },
    {
      "header": "QUANTITY_MIN",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "QUANTITY_INTERVAL",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "DELIVERY_TIME",
      "source": "constant",
      "expression": "'1'"
    },
    {
      "header": "ECLASS-5.1",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ECLASS-5.1.1",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ECLASS-6.0",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ECLASS-6.1",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ECLASS-6.2",
      "source": "master",
      "expression": "lookup(row['sku'], 'cst_eclass_category_keyword.csv', 'eclass_62')"
    },
    {
      "header": "ECLASS-7.1",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "ECLASS-8.0",
      "source": "master",
