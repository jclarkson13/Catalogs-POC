{
  "template_name": "jhu-core-store",
  "source_sample": "US - Johns Hopkins University Core Store Current/Future Price.xlsx",
  "description": "US Johns Hopkins Core Store file (xlsx, 7 columns): name from ariba_name(), List Price and discounted Core Cost as 2dp text USD for the price period, size from cst_qty_mkt_with_unit.csv.",
  "file_type": "xlsx",
  "sku_column": "SKU",
  "price_columns": [
    "List Price",
    "Core Cost"
  ],
  "columns": [
    {
      "header": "SKU",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "Name of Product",
      "source": "master",
      "expression": "ariba_name(row)"
    },
    {
      "header": "List Price",
      "source": "master",
      "expression": "price_for_rounded(row, 'list_price_usd', customer, 0)"
    },
    {
      "header": "Core Cost",
      "source": "master",
      "expression": "price_for_rounded(row, 'list_price_usd', customer, discount)"
    },
    {
      "header": "Long Description",
      "source": "master",
      "expression": "ariba_name_with_size(row)"
    },
    {
      "header": "URL",
      "source": "master",
      "expression": "row['product_url']"
    },
    {
      "header": "Size",
      "source": "master",
      "expression": "lookup(row['sku'], 'cst_qty_mkt_with_unit.csv', 'qty_mkt_with_unit', row['size'] + ' ' + row['size_unit'])"
    }
  ]
}
