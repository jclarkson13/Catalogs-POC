{
  "template_name": "de-helf",
  "source_sample": "DE - HELF Current/Future Price.xlsx",
  "description": "DE HELF BMEcat-style catalog (xlsx, 46 columns) in EUR. PRICE_AMOUNT1 is discounted list as 2dp text (Future customer at 0%). Descriptions use clean_pfizer_description; keywords from target alternate names. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "SUPPLIER_AID",
  "price_columns": [
    "PRICE_AMOUNT1"
  ],
  "columns": [
    {
      "header": "SUPPLIER_AID",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "DESCRIPTION_SHORT",
      "source": "master",
      "expression": "clean_pfizer_description(row['long_description']).replace('<lt/>', '<').replace('<gt/>', '>')[:35]"
    },
    {
      "header": "DESCRIPTION_LONG",
      "source": "master",
      "expression": "clean_pfizer_description(row['long_description']).replace('<lt/>', '<').replace('<gt/>', '>') + ((' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')') if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '') + ' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'qty_mkt_txt_abbrev_units', row['size'] + ' ' + row['size_unit']) + ')'"
    },
    {
      "header": "MANUFACTURER_NAME",
      "source": "constant",
      "expression": "'Cell Signaling Technology'"
    },
    {
      "header": "MANUFACTURER_AID",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "PRICE_QUANTITY",
      "source": "constant",
      "expression": "'1'"
    },
    {
      "header": "ORDER_UNIT",
      "source": "constant",
      "expression": "'PCE'"
    },
    {
      "header": "NO_CU_PER_OU",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "CONTENT_UNIT",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "LOWER_BOUND1",
      "source": "constant",
      "expression": "'1'"
    },
    {
      "header": "PRICE_AMOUNT1",
      "source": "master",
      "expression": "price_for_rounded(row, 'list_price_eur', customer, discount)"
    },
    {
      "header": "LOWER_BOUND2",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "PRICE_AMOUNT2",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "CURRENCY",
      "source": "constant",
