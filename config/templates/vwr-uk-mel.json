{
  "template_name": "vwr-uk-mel",
  "source_sample": "UK - VWR Current/Future Price.xlsx (same 'MEL Number' layout as Benelux/DE VWR exports)",
  "description": "UK VWR 'MEL Number' catalog (xlsx, 57 columns: the DE/Benelux layout plus GSK net price and a constant '15%' GSK discount label). GBP prices rounded half-up for the period; GSK price uses overrides.gsk_discount_percentage. Customers exclude the SKUs in coupa_marketplace_excluded_uk.csv.",
  "file_type": "xlsx",
  "sku_column": "Supplier Article Number",
  "price_columns": ["Gross Purchase Price", "Purchase Net Price GSK"],
  "columns": [
    { "header": "MEL Number", "expression": "''" },
    { "header": "Supplier Article Number", "expression": "row['sku']" },
    { "header": "Lead Time in Calendar days", "expression": "'2'" },
    { "header": "Basic UOM", "expression": "row['uom'].upper()" },
    { "header": "Pack Size", "expression": "row['size']" },
    { "header": "Pack Unit", "expression": "{'Kit':'Kit','Pack':'PAC','ea':'ea','g':'G','liter':'L','mg':'MG','ml':'ML','nmol':'NMO','tests':'tests','units':'units','vial':'VIA','western blots':'AS','x 384 tests':'x 384 tests','x 96 tests':'x 96 tests','µg':'µG','µl':'µL'}.get(row['size_unit'], row['size_unit'].upper())" },
    { "header": "Case Size", "expression": "''" },
    { "header": "Valid from", "expression": "str(int(customer['price_valid_from'][8:10])) + '/' + str(int(customer['price_valid_from'][5:7])) + '/' + customer['price_valid_from'][0:4]" },
    { "header": "Currency of the Purchase Price", "expression": "'GBP'" },
    { "header": "Gross Purchase Price", "expression": "(lookup(row['sku'], 'cst_uk_clp.csv', 'uk_clp_future' if customer.get('price_period') == 'future' else 'uk_clp') if discount == 0 else '') or price_for_rounded_half_up(row, 'list_price_gbp', customer, discount)" },
    { "header": "Purchase Net Price GSK", "expression": "price_for_rounded_half_up(row, 'list_price_gbp', customer, customer.get('overrides', {}).get('gsk_discount_percentage', 0))" },
    { "header": "Discount in % GSK", "expression": "'15%'" },
    { "header": "Purchase Price Unit", "expression": "'1 ' + row['uom'].upper()" },
    { "header": "Minimum Order Quantity", "expression": "'1'" },
    { "header": "Currency of the Recommended List Price", "expression": "'GBP'" },
    { "header": "Recommended European List Price", "expression": "''" },
    { "header": "Short Description English", "expression": "(lookup(row['sku'], 'cst_product_name_variants.csv', 'product_name_no_symbols', '') or row['long_description'].replace('<sup>®</sup>', '(R)').replace('<sup>™</sup>', '(tm)').replace('®', '(R)').replace('™', '(tm)'))[:35] + ' ' + sku_leading_digits(row['sku'])" },
    { "header": "Short Description German", "expression": "''", "allow_blank_description": true },
    { "header": "Short Description French", "expression": "''", "allow_blank_description": true },
    { "header": "Long Description English", "expression": "clean_vwr_long_description(row['long_description']).upper() + '-' + row['size'] + ' ' + row['size_unit'].replace('µ', 'u').upper() + ' ' + sku_leading_digits(row['sku'])" },
    { "header": "Long Description German", "expression": "''", "allow_blank_description": true },
    { "header": "Long Description French", "expression": "''", "allow_blank_description": true },
    { "header": "External Hierarchy", "expression": "''" },
    { "header": "Commodity Code", "expression": "'30021200'" },
    { "header": "Country of Origin", "expression": "'US'" },
    { "header": "Gross Weight", "expression": "''" },
    { "header": "Net Weight", "expression": "''" },
    { "header": "Weight Unit", "expression": "''" },
    { "header": "Batch Management", "expression": "'Y'" },
    { "header": "Maximum Shelf Life", "expression": "lookup(row['sku'], 'cst_shelf_life.csv', 'shelf_life', '')" },
    { "header": "Sterile", "expression": "''" },
    { "header": "Temperature Transport Condition", "expression": "{'AMBIENT': 'RT', 'COLD': '40', 'DRYICE': '70'}.get(row['shipping_conditions'], '')" },
    { "header": "Temperature Storage Condition", "expression": "{'-20C': 'T2', '+4C': 'T1', '-80C': 'T4', 'RT': 'T0', '4C and -20C': 'T2', '-80C, -20C, 4C': 'T4', 'RT, 4C, -20C': 'T2', 'RT and -20C': 'T2', '-80C and 4C': 'T4'}.get(row['storage_temperature'], '')" },
    { "header": "Hazardous Storage Condition", "expression": "''" },
    { "header": "EAN 13 Number", "expression": "''" },
    { "header": "UN-Packaging ", "expression": "''" },
    { "header": "Packaging Material Type", "expression": "''" },
    { "header": "Packaging Material Weight", "expression": "''" },
    { "header": "CE marking", "expression": "''" },
    { "header": "Medical Device Class", "expression": "''" },
    { "header": "GMDN Classification", "expression": "''" },
    { "header": "EDMA Classification", "expression": "''" },
    { "header": "CAS Number", "expression": "''" },
    { "header": "EINECS", "expression": "''" },
    { "header": "Molecular Formula", "expression": "lookup(row['sku'], 'cst_lsds_antibody_fields.csv', 'molecular_formula', '')" },
    { "header": "Molecular weight (g/mol)", "expression": "''" },
    { "header": "Flash Point (°C)", "expression": "''" },
    { "header": "MSDS", "expression": "lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'sds_url_eu_en')" },
    { "header": "UN Number", "expression": "''" },
    { "header": "ADR/RID & PG", "expression": "''" },
    { "header": "IMDG & PG", "expression": "''" },
    { "header": "IATA & PG", "expression": "''" },
    { "header": "H - Phrases", "expression": "''" },
    { "header": "P - Phrases", "expression": "''" },
    { "header": "Hierarchy", "expression": "''" },
    { "header": "ECN", "expression": "''" },
    { "header": "Web Exclusion", "expression": "''" }
  ]
}
