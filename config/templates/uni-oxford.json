{
  "template_name": "uni-oxford",
  "source_sample": "UK - University of Oxford Current/Future Price.xlsx",
  "description": "UK University of Oxford Oracle-punchout-style file (xlsx, 51 columns). List Price is the raw GBP string from cst_uk_clp.csv and Price is discounted, rounded half-up, for the price period; hazard, UN number and CAS columns from cst_hazmat_cas_fields.csv. Customers exclude the SKUs in coupa_marketplace_excluded_uk.csv.",
  "file_type": "xlsx",
  "sku_column": "Supplier Item",
  "price_columns": ["List Price", "Price"],
  "columns": [
    {"header": "Item Section", "source": "constant", "expression": "''"},
    {"header": "Action", "source": "constant", "expression": "'SYNC'"},
    {"header": "Line Number", "source": "master", "expression": "row['sku']"},
    {"header": "Line Type", "source": "constant", "expression": "''"},
    {"header": "Thumbnail Image", "source": "master", "expression": "row['image_url']"},
    {"header": "Image", "source": "master", "expression": "row['image_url']"},
    {"header": "Description", "source": "master", "expression": "clean_gladstone_description(row['long_description']) + ' ' + sku_leading_digits(row['sku'])"},
    {"header": "Shopping Category", "source": "constant", "expression": "'Antigens, Antibodies and Associated Products'"},
    {"header": "Category", "source": "constant", "expression": "''"},
    {"header": "Supplier Item", "source": "master", "expression": "row['sku']"},
    {"header": "Supplier Part Auxiliary ID", "source": "constant", "expression": "''"},
    {"header": "Internal Item Number", "source": "constant", "expression": "''"},
    {"header": "Item Revision", "source": "constant", "expression": "''"},
    {"header": "Manufacturer", "source": "master", "expression": "row['manufacturer']"},
    {"header": "Manufacturer Item", "source": "master", "expression": "row['sku']"},
    {"header": "Product Size", "source": "master", "expression": "(row['size'] + ' ' + row['size_unit']).replace('µ', 'u')"},
    {"header": "Unit", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "List Price", "source": "master", "expression": "lookup(row['sku'], 'cst_uk_clp.csv', 'uk_clp_future' if customer.get('price_period') == 'future' else 'uk_clp') or price_for_rounded_half_up(row, 'list_price_gbp', customer, 0)"},
    {"header": "Price", "source": "master", "expression": "price_for_rounded_half_up(row, 'list_price_gbp', customer, discount)"},
    {"header": "Availability", "source": "constant", "expression": "''"},
    {"header": "Lead Time", "source": "constant", "expression": "'3'"},
    {"header": "Radioactive", "source": "constant", "expression": "''"},
    {"header": "Hazardous Material", "source": "constant", "expression": "''"},
    {"header": "Controlled Substance", "source": "constant", "expression": "''"},
    {"header": "Toxin", "source": "constant", "expression": "''"},
    {"header": "Schedule 5 Pathogen and Toxins", "source": "constant", "expression": "''"},
    {"header": "Chemical weapons precursor", "source": "constant", "expression": "''"},
    {"header": "UNSPSC Code", "source": "constant", "expression": "'99013112'"},
    {"header": "Alias", "source": "constant", "expression": "''"},
    {"header": "Comments", "source": "constant", "expression": "''"},
    {"header": "Long Description", "source": "master", "expression": "clean_gladstone_description(row['long_description']) + ' ' + sku_leading_digits(row['sku'])"},
    {"header": "Attachment URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Supplier URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Manufacturer URL", "source": "master", "expression": "row['product_url'].replace('.html', '') + '?country=GB'"},
    {"header": "Alternative Item", "source": "constant", "expression": "''"},
    {"header": "Un Number", "source": "master", "expression": "lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'un_number')"},
    {"header": "Hazard Class", "source": "master", "expression": "lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'hazardous_class_div')"},
    {"header": "Lowest Cost Item", "source": "constant", "expression": "''"},
    {"header": "Green Item", "source": "constant", "expression": "''"},
    {"header": "Green Supplier", "source": "constant", "expression": "''"},
    {"header": "Equivalent Item", "source": "constant", "expression": "''"},
    {"header": "CAS number", "source": "master", "expression": "','.join(x for x in [lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'commercial_cas_number'), lookup(row['sku'], 'cst_hazmat_cas_fields.csv', 'constituent_cas_number')] if x)"},
    {"header": "Preferred Item Status", "source": "constant", "expression": "''"},
    {"header": "Expiration Date", "source": "constant", "expression": "''"},
    {"header": "Ship-To Org", "source": "constant", "expression": "''"},
    {"header": "Ship-To Location", "source": "constant", "expression": "''"},
    {"header": "Quantity", "source": "constant", "expression": "''"},
    {"header": "Effective From", "source": "constant", "expression": "''"},
    {"header": "Effective To", "source": "constant", "expression": "''"},
    {"header": "Break Price", "source": "constant", "expression": "''"},
    {"header": "Discount", "source": "constant", "expression": "''"}
  ]
}
