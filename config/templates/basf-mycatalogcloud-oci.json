  "description": "BASF myCatalogCloud OCI punchout catalog (xlsx, 117 columns, first header blank) in EUR, CST plus NEB rows. Only price tier 1 of the repeated tier blocks is filled; dangerous-goods flag and eCl@ss code come from basf_dg_eclass.csv.",
  "file_type": "xlsx",
  "sku_column": "SupplierAID",
  "price_columns": [
    "ArticlePriceDetails.ArticlePrice.1.PriceAmount"
  ],
  "master_source": [
    "products.csv",
