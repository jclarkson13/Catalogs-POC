{
  "template_name": "uniklinikum-koeln",
  "source_sample": "DE - Uniklinikum Köln Current/Future Price.xlsx",
  "description": "DE Uniklinikum Köln hospital catalog (xlsx, 37 German columns) in EUR. Listenpreis plus a literal 'Rabatt in %' and gross price incl. VAT; Staffel tiers stay blank. E-CLASS 9.0 and keywords from master lookups. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "Artikelnummer",
  "price_columns": ["Listenpreis"],
  "columns": [
    {"header": "Katalogname", "source": "constant", "expression": "''"},
    {"header": "Lieferant", "source": "constant", "expression": "'1617753'"},
    {"header": "Artikelnummer", "source": "master", "expression": "row['sku']"},
    {"header": "Herstellerteilenummer", "source": "master", "expression": "row['sku']"},
    {"header": "Herstellername", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Kurztext (100 Zeichen)", "source": "master", "expression": "(row['long_description'].replace('<lt/>sup<gt/>', ' ').replace('<lt/>/sup<gt/>', '').replace('<sup>', ' ').replace('</sup>', '').replace('®', '00AE'))[:100].rstrip()"},
    {"header": "Langtext (1024 Zeichen)", "source": "master", "expression": "((row['long_description'].replace('<lt/>sup<gt/>', ' ').replace('<lt/>/sup<gt/>', '').replace('<sup>', ' ').replace('</sup>', '').replace('®', '00AE')) + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev', '') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev', '') else ''))[:1024].rstrip()"},
    {"header": "Listenpreis", "source": "master", "expression": "raw_price_eur(row, customer)"},
    {"header": "Rabatt in %", "source": "customer", "expression": "str(discount)"},
    {"header": "Währung", "source": "constant", "expression": "'EUR'"},
    {"header": "Bruttopreis in € (Nettopreis + MwSt.)", "source": "master", "expression": "float(Decimal(str(price_for(row, 'list_price_eur', customer))) * (Decimal('1.19') if customer.get('price_period', 'current') == 'future' else Decimal('1.0115')))"},
    {"header": "pro", "source": "constant", "expression": "'1'"},
    {"header": "Preiseinheit", "source": "constant", "expression": "'ST'"},
    {"header": "Staffel 1", "source": "constant", "expression": "''"},
    {"header": "Staffelpreis 1", "source": "constant", "expression": "''"},
    {"header": "Staffel 2", "source": "constant", "expression": "''"},
    {"header": "Staffelpreis 2", "source": "constant", "expression": "''"},
    {"header": "Staffel 3", "source": "constant", "expression": "''"},
    {"header": "Staffelpreis 3", "source": "constant", "expression": "''"},
    {"header": "Staffel 4", "source": "constant", "expression": "''"},
    {"header": "Staffelpreis 4", "source": "constant", "expression": "''"},
    {"header": "Menge/VE", "source": "constant", "expression": "'1'"},
    {"header": "Veinheit", "source": "constant", "expression": "'ST'"},
    {"header": "MwSt.", "source": "constant", "expression": "'0%'"},
    {"header": "Lieferzeit ", "source": "constant", "expression": "'1 to 4 days'"},
    {"header": "Mindestmenge", "source": "constant", "expression": "'1'"},
    {"header": "Preisgültigkeit (MM/JJ)", "source": "customer", "expression": "customer['price_valid_until'][8:10] + '.' + customer['price_valid_until'][5:7] + '.' + customer['price_valid_until'][:4]"},
    {"header": "EAN Code", "source": "constant", "expression": "''"},
    {"header": "Warengruppe Lieferant", "source": "constant", "expression": "'6608FA'"},
    {"header": "Eclass 9.0", "source": "master", "expression": "lookup(row['sku'], 'cst_eclass_category_keyword.csv', 'eclass_62')"},
    {"header": "Einkaufsorganisation", "source": "constant", "expression": "''"},
    {"header": "Werk", "source": "constant", "expression": "''"},
    {"header": "Schlagworte", "source": "constant", "expression": "''"},
    {"header": "Folgebeleg", "source": "constant", "expression": "''"},
    {"header": "Eiskosten (100Zeichen)", "source": "constant", "expression": "''"},
    {"header": "Frachtkosten (100 Zeichen)", "source": "constant", "expression": "''"},
    {"header": "Bemerkung an den Lieferanten", "source": "constant", "expression": "''"}
  ]
}
