{
  "template_name": "rptu-kaiserlautern",
  "source_sample": "DE - RPTU Kaiserlautern Current/Future Price.xlsx",
  "description": "DE RPTU Kaiserslautern procurement catalog (xlsx, 64 German columns) in EUR with a single price tier (Preis1); Preis2-5 stay blank. E-CLASS and keywords from master lookups. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "Artikelnummer",
  "price_columns": [
    "Preis1"
  ],
  "columns": [
    {"header": "Produktgruppe", "source": "master", "expression": "row['product_classification']"},
    {"header": "Artikelnummer", "source": "master", "expression": "row['sku']"},
    {"header": "Artikelname", "source": "master", "expression": "cst_product_name(row, raw=True) + ' ' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'qty_mkt_txt_abbrev_units', row['size'] + ' ' + row['size_unit'])"},
    {"header": "Artikelbeschreibung", "source": "master", "expression": "cst_product_name(row, raw=True) + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '') + ' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'qty_mkt_txt_abbrev_units', row['size'] + ' ' + row['size_unit']) + ')'"},
    {"header": "EAN_Nummer", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Alternative_Artikelnummer", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Artikelnummer_einkaufendes_Unternehmen", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Herstellernummer", "source": "master", "expression": "row['sku']"},
    {"header": "Hersteller", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "ERP_Warengruppe_einkaufendes_Unternehmen", "source": "constant", "expression": "''", "allow_blank_description": true},
