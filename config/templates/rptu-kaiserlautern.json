    {"header": "Regellieferzeit", "source": "constant", "expression": "'2'"},
    {"header": "Sonderbehandlungsklasse", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Sonderbehandlungsklassentyp", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Schlüsselworte", "source": "constant", "expression": "''", "allow_blank_description": true},
