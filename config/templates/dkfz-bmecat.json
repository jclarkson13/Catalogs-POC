{
  "template_name": "dkfz-bmecat",
  "source_sample": "DE - DKFZ Current/Future Price.xlsx",
  "description": "DE DKFZ BMEcat-style catalog (xlsx, sheet Sheet1, 26 columns) in EUR for the price period. WARENTARIFNUMMER, origin, weight and SDS fields come from cst_dkfz_bmecat_fields.csv; descriptions use clean_pfizer_description. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sheet_name": "Sheet1",
  "sku_column": "SUPPLIER_AID",
  "price_columns": ["PRICE_AMOUNT1"],
  "columns": [
    {"header": "SUPPLIER_AID", "source": "master", "expression": "row['sku']"},
    {"header": "WARENTARIFNUMMER", "source": "lookup", "expression": "lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'intrastat_no', '3002.12.00').replace('.', '')"},
    {"header": "URSPRUNGSLAND", "source": "constant", "expression": "'US'"},
    {"header": "GEWICHT_KG", "source": "constant", "expression": "''"},
    {"header": "ECLASS", "source": "constant", "expression": "'32160500'"},
    {"header": "GROUP_NAME", "source": "master", "expression": "row['product_classification']"},
    {"header": "DESCRIPTION_SHORT", "source": "master", "expression": "clean_pfizer_description(row['long_description']) + ' ' + row['size'] + ' ' + row['size_unit'].replace(chr(181), 'u')"},
    {"header": "DESCRIPTION_LONG", "source": "master", "expression": "row['long_description'] + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '') + ' (' + row['size'] + ' ' + row['size_unit'].replace(chr(181), 'u') + ')'"},
    {"header": "ORDER_UNIT", "source": "constant", "expression": "'PA'"},
    {"header": "NO_CU_PER_OU", "source": "master", "expression": "f\"{float(row['size']):.2f}\".replace('.', ',')"},
    {"header": "CONTENT_UNIT", "source": "constant", "expression": "'PCE'"},
    {"header": "PRICE_AMOUNT1", "source": "master", "expression": "(lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'eu_future_list_price' if customer.get('price_period') == 'future' else 'eu_list_price') if discount == 0 else '') or price_for_rounded(row, 'list_price_eur', customer, discount)"},
    {"header": "PRICE_CURRENCY", "source": "constant", "expression": "'EUR'"},
    {"header": "PRICE_FACTOR1", "source": "constant", "expression": "'0.79'"},
    {"header": "TAX", "source": "constant", "expression": "'0,19'"},
    {"header": "MANUFACTURER_AID", "source": "master", "expression": "row['sku']"},
    {"header": "MANUFACTURER_NAME", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "DELIVERY_TIME", "source": "constant", "expression": "'3'"},
    {"header": "REMARKS", "source": "master", "expression": "row['size'] + ' ' + row['size_unit'].replace(chr(181), 'u') + ' ( ' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ' )'"},
    {"header": "KEYWORD", "source": "lookup", "expression": "lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'sales_category')"},
    {"header": "H-Sätze", "source": "constant", "expression": "''"},
    {"header": "Gefahrstoffsymbol", "source": "constant", "expression": "''"},
    {"header": "MIME_SOURCE1", "source": "master", "expression": "row['product_url']"},
    {"header": "MIME_DESCR1", "source": "constant", "expression": "'ProductInformation'"},
    {"header": "MIME_SOURCE2", "source": "lookup", "expression": "lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'sds_url_eu_de') or lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'sds_url_eu_en')"},
    {"header": "MIME_DESCR2", "source": "constant", "expression": "'Sicherheitsdatenblatt'"}
  ]
}
