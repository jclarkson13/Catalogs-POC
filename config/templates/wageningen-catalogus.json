  "columns": [
    {"header": "Mutatietype", "source": "constant", "expression": "'I'"},
    {"header": "Art. nr. Leverancier", "source": "master", "expression": "row['sku']"},
    {"header": "Art. Nr. Merk", "source": "master", "expression": "row['sku']"},
    {"header": "BTW Code", "source": "constant", "expression": "'H'"},
    {"header": "Bruto prijs", "source": "master", "expression": "price_text(row['list_price_eur'])"},
    {"header": "Netto prijs", "source": "master", "expression": "price_text(row['list_price_eur'], discount)"},
    {"header": "Valuta", "source": "constant", "expression": "'EUR'"},
    {"header": "Besteleenheid", "source": "constant", "expression": "'STUK'"},
    {"header": "Inhoudseenheid", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Aantal inhoudseenheden per besteleenheid", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Bestelgrootte", "source": "constant", "expression": "'1.00'"},
    {"header": "Minimale bestelgrootte", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Maximale bestelgrootte", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Kernassortiment", "source": "constant", "expression": "'1'"},
    {"header": "Levertijd (dagen)", "source": "master", "expression": "'2' if row['manufacturer'] == 'New England Biolabs' else '1'"},
    {"header": "Artikelnaam", "source": "master", "expression": "cst_product_name(row, raw=True)"},
    {"header": "Artikel beschrijving", "source": "master", "expression": "row['sku'] + ' - ' + cst_product_name(row, raw=True)"},
    {"header": "Artikel afbeelding", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Taalcode", "source": "constant", "expression": "'EN'"},
    {"header": "Omschrijving 1", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Omschrijving 2: Naam van het Merk", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Omschrijving 3", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "URL Artikelinformatie", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Niveau 1", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Niveau 2", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Niveau 3", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Niveau 4", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Niveau 5", "source": "constant", "expression": "''", "allow_blank_description": true}
  ]
}
