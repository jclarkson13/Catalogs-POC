{
  "template_name": "distributor-staggered-lsds",
  "source_sample": "US - LSDS Current Price.xlsx / US - LSDS Future Price.xlsx",
  "description": "US LSDS catalog (xlsx, 74 columns): Gladstone-style staggered-price base plus about 43 antibody/chemical attribute columns from cst_lsds_antibody_fields.csv. Price is 2dp text USD for the price period; text uses clean_coupa_description.",
  "file_type": "xlsx",
  "master_source": "products.csv",
  "sku_column": "SupplierPartID",
  "price_columns": [
    "Price"
  ],
  "columns": [
    {
      "header": "ManufacturerName",
      "expression": "row['manufacturer']"
    },
    {
      "header": "ManufacturerPartID",
      "expression": "row['sku']"
    },
    {
      "header": "SupplierPartID",
      "expression": "row['sku']"
    },
    {
      "header": "ShortDescription",
      "expression": "clean_coupa_description(row['long_description'], 'us').replace('µ', 'u')[:35]"
    },
    {
      "header": "LongDescription",
      "expression": "clean_coupa_description(row['long_description'] + ' ' + row['size'] + ' ' + row['size_unit'], 'us').replace('µ', 'u')"
    },
    {
      "header": "Synonyms",
      "expression": "''"
    },
    {
      "header": "Price",
      "expression": "strip_trailing_zeros(price_for_rounded(row, 'list_price_usd', customer, discount))"
    },
    {
      "header": "ListPrice",
      "expression": "''"
    },
    {
      "header": "Currency",
      "expression": "'USD'"
    },
    {
      "header": "PriceBase",
      "expression": "'1'"
    },
    {
      "header": "MinimumQuantity",
      "expression": "''"
    },
    {
      "header": "QuantityInterval",
      "expression": "''"
