{
  "template_name": "evotec-coupa-style",
  "source_sample": "DE - Evotec Current/Future Price.xlsx",
  "description": "DE Evotec Coupa-style item upload (xlsx, 56 columns) in EUR. Price is discounted list rounded half-up as text, Supplier Item List Price is the raw EUR list. 'Savings %' is the constant '20' as in the real file, not the actual discount. Customers exclude the SKUs in coupa_marketplace_excluded_de.csv.",
  "file_type": "xlsx",
  "sku_column": "Supplier Part Num",
  "price_columns": [
    "Price",
    "Supplier Item List Price"
  ],
  "columns": [
    {"header": "Name*", "source": "master", "expression": "ariba_name(row).replace('<lt/>', '<').replace('<gt/>', '>').replace('<sup>', ' ').replace('</sup>', '') + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '') + ' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'qty_mkt_txt_abbrev_units', row['size'] + ' ' + row['size_unit']) + ')'"},
    {"header": "Description*", "source": "master", "expression": "ariba_name(row).replace('<lt/>', '<').replace('<gt/>', '>').replace('<sup>', ' ').replace('</sup>', '') + (' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') + ')' if lookup(row['sku'], 'cst_marketing_name_details.csv', 'test_count_uni_abbrev') else '') + ' (' + lookup(row['sku'], 'cst_marketing_name_details.csv', 'qty_mkt_txt_abbrev_units', row['size'] + ' ' + row['size_unit']) + ')'"},
    {"header": "UOM Code*", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "Purchasable", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "active", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Purchasing Questionnaire", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "RFQ Questionnaire", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Receiving Questionnaire", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Item Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Item Classification", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Image URL", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Image Filename", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Commodity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Tags", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Preferred", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Contract Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Pricing Type", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Price", "source": "master", "expression": "price_for_rounded_half_up(row, 'list_price_eur', customer, discount)"},
    {"header": "Currency", "source": "constant", "expression": "'EUR'"},
    {"header": "Supplier Part Num", "source": "master", "expression": "row['sku']"},
    {"header": "Supplier Aux Part Num", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Lead Time", "source": "constant", "expression": "'3'"},
    {"header": "Manufacturer", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Savings %", "source": "customer", "expression": "'20'"},
    {"header": "Require Inspection", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Require Asset Tag", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Require RFID", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Storage Quantity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Storage UOM", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Consumption Quantity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Consumption UOM", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Use Pack Weight", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Pack Quantity", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Pack Weight", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Pack Weight UOM", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Receive Catch Weight", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "UNSPSC Code", "source": "master", "expression": "row['unspsc']"},
    {"header": "Contract Term", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Allow Partial Qty", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Require Barcode", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Inventory Lot Tracking Enabled", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Inventory Lot Expiration Type", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Manufacturer Name", "source": "master", "expression": "row['manufacturer'].replace(', Inc.', '')"},
    {"header": "Manufacturer Part Number", "source": "master", "expression": "row['sku']"},
    {"header": "Coupa Internal Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Coupa Supplier Internal Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Hazard Codes", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Precautionary Codes", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Manufacturer Part Number_cf", "source": "master", "expression": "row['sku']"},
    {"header": "IFS Part Number", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "CAS_Number", "source": "master", "expression": "(lookup(row['sku'], 'cst_commercial_cas_raw.csv', 'commercial_cas_number_raw', '') + (', ' if lookup(row['sku'], 'cst_commercial_cas_raw.csv', 'commercial_cas_number_raw', '') and lookup(row['sku'], 'cst_constituent_cas_raw.csv', 'constituent_cas_number_raw', '') else '') + lookup(row['sku'], 'cst_constituent_cas_raw.csv', 'constituent_cas_number_raw', '')).strip()", "allow_blank_description": true},
    {"header": "UN Packing Group", "source": "constant", "expression": "''", "allow_blank_description": true},
    {"header": "Supplier Item List Price", "source": "master", "expression": "lookup(row['sku'], 'cst_dkfz_bmecat_fields.csv', 'eu_future_list_price' if customer.get('price_period') == 'future' else 'eu_list_price', '') or price_for_rounded_half_up(row, 'list_price_eur', customer, 0)"},
    {"header": "Supplier Item Link to Safety Data Sheet", "source": "master", "expression": "lookup(row['sku'], 'cst_sds_url_de.csv', 'sds_url_eu_en', msds_url_or_blank(row))"}
  ]
}
