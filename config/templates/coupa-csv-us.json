{
  "template_name": "coupa-csv-us",
  "source_sample": "US - Coupa Current/Future Price.csv",
  "description": "US Coupa item-load CSV (63 columns, semicolon-delimited, LF line endings, no BOM). Only about 12 columns carry data; Price (Tier 1-20) columns stay blank, so no price is written. Text uses clean_gladstone/clean_pfizer_description.",
  "file_type": "csv",
  "delimiter": ";",
  "csv_format": {"lineterminator": "\n"},
  "sku_column": "Supplier Part Number*",
  "price_columns": [
    "Price (Tier 1)"
  ],
  "columns": [
    {
      "header": "Supplier Part Number*",
      "source": "master",
      "expression": "row['sku']"
    },
    {
      "header": "Supplier Aux Part Num",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Name*",
      "source": "master",
      "expression": "clean_pfizer_description(row['long_description']) + ' ' + row['size'] + ' ' + row['size_unit'].replace(chr(181), 'u')"
    },
    {
      "header": "Description*",
      "source": "master",
      "expression": "clean_gladstone_description(row['long_description']) + ' ' + row['size'] + ' ' + row['size_unit']"
    },
    {
      "header": "Currency Code*",
      "source": "constant",
      "expression": "'USD'"
    },
    {
      "header": "UOM Code*",
      "source": "master",
      "expression": "row['uom'].upper()"
    },
    {
      "header": "active*",
      "source": "constant",
      "expression": "'Yes'"
    },
    {
      "header": "Item Classification Name",
      "source": "master",
      "expression": "row['product_classification']"
    },
    {
      "header": "UNSPSC Code",
      "source": "master",
      "expression": "row['unspsc']"
    },
    {
      "header": "Lead Time",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Manufacturer",
      "source": "master",
      "expression": "row['manufacturer']"
    },
    {
      "header": "Contract Number",
      "source": "constant",
      "expression": "'0000001429LOC1-CSN'"
    },
    {
      "header": "Contract Term",
      "source": "constant",
      "expression": "''"
    },
    {
      "header": "Savings %",
      "source": "customer",
      "expression": "str(int(discount)) + '%'"
    },
    {
      "header": "Price (Tier 1)",
