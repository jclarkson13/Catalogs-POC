{
  "template_name": "one-advanced-network",
  "source_sample": "UK - One Advanced Current/Future Price.xlsx",
  "description": "UK One Advanced network file (xlsx, 24 columns): listPrice plus one price column per UK institution (22), each from its own discount, rounded half-up. listPrice is the raw GBP string from cst_uk_clp.csv for the price period. Customers exclude the SKUs in coupa_marketplace_excluded_uk.csv.",
  "file_type": "xlsx",
  "sku_column": "supplierPartNo",
  "price_columns": ["listPrice", "Cambridge University", "Cardiff University", "King's College London", "Manchester University", "UKSBS", "Queen Mary University of London", "University College London", "University of Birmingham", "University of Bradford", "University of Hertfordshire Discount Price", "University of Leeds ", "University of Leicester ", "University of Liverpool", "Nottingham Trent University", "University of York ", "Francis Crick Institute", "Liverpool School of Tropical Medicine", "Sheffield University", "City St George's University of London", "UKHSA", "University of Exeter", "University of Reading"],
  "columns": [
