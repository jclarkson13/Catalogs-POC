    {"header": "listPrice", "source": "master", "expression": "lookup(row['sku'], 'cst_uk_clp.csv', 'uk_clp_future' if customer.get('price_period') == 'future' else 'uk_clp') or price_for_rounded_half_up(row, 'list_price_gbp', customer, 0)"},
    {"header": "Cambridge University", "source": "institution", "expression": "price_for_rounded_half_up(row, 'list_price_gbp', customer, customer['institutions']['cambridge']['discount_percentage'])"},
