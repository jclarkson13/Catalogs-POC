{
  "template_name": "punchout-tiered",
  "source_sample": "US - Abbott Abbvie HubWoo Current/Future Price.xlsx",
  "description": "US AbbVie HubWoo punchout catalog (xlsx, 39 columns). Price 1 is the discounted USD price and Retail Price the list, both 2dp text; Price 2/3 quantity breaks stay blank. Descriptions use clean_abbvie_description.",
  "file_type": "xlsx",
  "sku_column": "Item Number",
  "price_columns": ["Price 1", "Price 2", "Price 3", "Retail Price"],
  "columns": [
    {"header": "Item Number", "source": "master", "expression": "row['sku']"},
    {"header": "UNSPSC Code", "source": "master", "expression": "row['unspsc']"},
    {"header": "Short Description", "source": "master", "expression": "clean_abbvie_description(row['long_description'])[:35]"},
    {"header": "Long Description", "source": "master", "expression": "f\"{clean_abbvie_description(row['long_description'])} {row['size']} {row['size_unit'].replace(chr(181), 'u')}\""},
    {"header": "Price quantity", "source": "master", "expression": "'1'"},
    {"header": "Orderunit", "source": "master", "expression": "row['uom'].upper()"},
    {"header": "Minimum Order Quantity", "source": "master", "expression": "''"},
    {"header": "Price 1", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, discount)"},
    {"header": "Currency", "source": "master", "expression": "row['currency']"},
    {"header": "Lead Time", "source": "master", "expression": "'1'"},
    {"header": "Manufacturer's Item Number", "source": "master", "expression": "''"},
    {"header": "Manufacturer Name", "source": "master", "expression": "''"},
    {"header": "Lower Bound Price 2", "source": "master", "expression": "''"},
    {"header": "Price 2", "source": "master", "expression": "''"},
    {"header": "Lower Bound Price 3", "source": "master", "expression": "''"},
    {"header": "Price 3", "source": "master", "expression": "''"},
    {"header": "Retail Price", "source": "master", "expression": "price_for_rounded(row, 'list_price_usd', customer, 0)"},
    {"header": "Order Quantity Interval", "source": "master", "expression": "''"},
    {"header": "Contentunits per Orderunit", "source": "master", "expression": "''"},
    {"header": "Content Unit", "source": "master", "expression": "''"},
    {"header": "Is a Hazardous material", "source": "master", "expression": "'N'"},
    {"header": "CAS #", "source": "master", "expression": "''"},
    {"header": "AbbVie Supplier ERP Vendor #", "source": "master", "expression": "''"},
    {"header": "Smart form type", "source": "master", "expression": "''"},
    {"header": "Smart form id", "source": "master", "expression": "''"},
    {"header": "Keywords", "source": "master", "expression": "''"},
    {"header": "Supplier's Old Item Number", "source": "master", "expression": "''"},
    {"header": "Picture / Attachment 1", "source": "master", "expression": "''"},
    {"header": "Type of Attachment 2", "source": "master", "expression": "''"},
    {"header": "Attachment 2", "source": "master", "expression": "''"},
    {"header": "Description of Attachment 2", "source": "master", "expression": "''", "allow_blank_description": true},
    {"header": "Type of Attachment 3", "source": "master", "expression": "''"},
    {"header": "Attachment 3", "source": "master", "expression": "''"},
    {"header": "Description of Attachment 3", "source": "master", "expression": "''", "allow_blank_description": true},
    {"header": "Type of Attachment 4", "source": "master", "expression": "''"},
    {"header": "Attachment 4", "source": "master", "expression": "''"},
    {"header": "Description of Attachment 4", "source": "master", "expression": "''", "allow_blank_description": true},
    {"header": "Price valid from", "source": "customer", "expression": "customer['price_valid_from'].replace('-', '')"},
    {"header": "Price valid until", "source": "customer", "expression": "customer['price_valid_until'].replace('-', '')"}
  ]
}
